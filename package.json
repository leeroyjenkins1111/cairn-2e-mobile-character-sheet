{
  "name": "cairn-2e-mobile-character-sheet",
  "version": "0.30.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-site.mjs _site",
    "check:syntax": "node scripts/check-js-syntax.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "check:production": "npm run build && node scripts/check-production-runtime.mjs",
    "test:unit": "node --test tests/unit/**/*.test.mjs",
    "test": "playwright test",
    "test:ci": "playwright test --reporter=line"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0"
  }
}
